# knot-fix.mjs 配置模板 —— 复制为 agent/.env 并填入真实值（.env 已 gitignore，禁止提交）

# GitHub Fine-grained PAT（权限：Contents + Pull requests + Issues，均 Read and write）
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# 仓库（owner/name）
GITHUB_REPO=wechatjs/verify-article-structure-spec

# 智能体平台 API 地址（内部平台地址见团队内部文档，禁止写入公开仓）
KNOT_API_BASE=
# 智能体平台个人 token（平台设置页的 Token 管理处申请）
KNOT_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 智能体 ID（智能体编辑/详情页 URL 里那串）
KNOT_AGENT_ID=xxxxxxxx
# 绑定的工作区 uuid（智能体平台工作区列表查看）
KNOT_AGENT_CLIENT_UUID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 模型（见智能体平台 API 文档的"可选模型"章节）
KNOT_MODEL=claude-sonnet-5.5

# 工作区机器上 spec 仓的绝对路径（注入给智能体终端环境变量 REPO_PATH）
REPO_PATH=/home/user/verify-article-structure-spec

# 可选
#KNOT_POLL_MINUTES=3          # 常驻轮询间隔
#KNOT_TIMEOUT_MINUTES=45      # 单次智能体调用超时（修复+测试可能要 10-40 分钟）
#KNOT_MAX_ISSUES_PER_RUN=1    # 每轮最多处理几个 issue
